# Base URL of the EduFormation application (no trailing slash)
VITE_APP_URL=http://localhost:3000

# Canonical origin of this site, used for og:url / canonical
VITE_SITE_URL=https://www.example.com

# [OWNER] contact channel for the demo CTA
VITE_CONTACT_EMAIL=contact@example.com

# [OWNER] optional form endpoint (POST, JSON). Leave empty to disable the form
# and fall back to a mailto: link.
VITE_CONTACT_ENDPOINT=
