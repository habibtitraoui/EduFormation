# Canonical origin of this site, used for og:url / canonical
VITE_SITE_URL=https://www.example.com

# Contact destination used by the contact form and direct email links
VITE_CONTACT_EMAIL=titraoui.habibe@gmail.com

# Optional contact service accepting a JSON POST with name, email, and message.
# When unset, the form opens a prefilled message in the visitor's email app.
VITE_CONTACT_ENDPOINT=
